# =============================
# 🔒 Безопасность и базовые настройки
# =============================

# Запрет листинга директорий
Options -Indexes

# Закрываем служебные файлы
<FilesMatch "(?i)\.(tpl|ini|log|txt)$">
  Require all denied
</FilesMatch>

# Разрешаем robots.txt
<Files "robots.txt">
  Require all granted
</Files>

# =============================
# 🔁 Перезаписи (Rewrite)
# =============================
RewriteEngine On

# ---------------------------------
# 🚫 Редирект всех index.* на /
# ---------------------------------
# Любые index.php, index.html, index.htm и т.п. → /
RewriteCond %{THE_REQUEST} \s/+index\.(php|html?|asp|aspx|cgi|pl)\s [NC]
RewriteRule ^index\.(php|html?|asp|aspx|cgi|pl)$ / [R=301,L]

# =============================
# 🎨 Роутинг темы (frontend)
# =============================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule "(?i)^theme/([^/]+)/(.*)$" /Views/Catalog/$1/$2 [L]

# =============================
# ⚙️ Роутинг админки (assets)
# =============================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule "(?i)^admin/assets/(.*)$" /Views/Admin/Assets/$1 [L]

# =============================
# 🧭 Основной роутинг (index.php)
# =============================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]

